               "Column", 
               GridBoxItemSize -> {
                "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
              Dynamic[Typeset`open]},
             "IconizedObject"]],
           Sequence[
            MessageName[$CellContext`GenerateSteps, "bads"], $CellContext`idx],
           SelectWithContents->True,
           Selectable->False], "]"}], ";", " ", "$Failed"}], ",", "\n", 
        "\t\t", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "dim", "]"}], " ", "+", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"scale", " ", "-", " ", "1"}], ")"}], " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"UnitVector", "[", 
             RowBox[{"dim", ",", " ", "idx"}], "]"}], ",", " ", 
            RowBox[{"UnitVector", "[", 
             RowBox[{"dim", ",", " ", "idx"}], "]"}]}], "]"}]}]}]}], "\n", 
       "\t", "]"}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"l", "'"}], " ", "=", " ", "r"}], ",", " ", 
       RowBox[{
        RowBox[{"r", "'"}], " ", "=", " ", "l"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"p", "[", 
       RowBox[{"dim_Integer", ",", " ", 
        RowBox[{"{", 
         RowBox[{"l_Integer", ",", " ", "r_Integer"}], "}"}]}], "]"}], " ", ":=",
       " ", 
      RowBox[{"If", "[", 
       RowBox[{
        InterpretationBox[
         DynamicModuleBox[{Typeset`open = False}, 
          TemplateBox[{"Expression", 
            StyleBox[
            "\"Condition\"", "IconizedCustomName", StripOnInput -> False], 
            GridBox[{{
               RowBox[{
                 TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["Not", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Byte count: \"", "IconizedLabel"], 
                 "\[InvisibleSpace]", 
                 TagBox["328", "IconizedItem"]}]}}, 
             GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
             "Column", 
             GridBoxItemSize -> {
              "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
            Dynamic[Typeset`open]},
           "IconizedObject"]],
         Not[
          And[
          1 <= $CellContext`l <= $CellContext`dim, 
           1 <= $CellContext`r <= $CellContext`dim, $CellContext`l != \
$CellContext`r]],
         SelectWithContents->True,
         Selectable->False], ",", " ", 
        RowBox[{
         RowBox[{"Message", "[", 
          InterpretationBox[
           DynamicModuleBox[{Typeset`open = False}, 
            TemplateBox[{"Expression", 
              StyleBox[
              "\"Failure\"", "IconizedCustomName", StripOnInput -> False], 
              GridBox[{{
                 RowBox[{
                   TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                   TagBox["Sequence", "IconizedItem"]}]}, {
                 RowBox[{
                   TagBox["\"Length: \"", "IconizedLabel"], 
                   "\[InvisibleSpace]", 
                   TagBox["4", "IconizedItem"]}]}, {
                 RowBox[{
                   TagBox["\"Byte count: \"", "IconizedLabel"], 
                   "\[InvisibleSpace]", 
                   TagBox["200", "IconizedItem"]}]}}, 
               GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
               "Column", 
               GridBoxItemSize -> {
                "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
              Dynamic[Typeset`open]},
             "IconizedObject"]],
           Sequence[
            
            MessageName[$CellContext`GenerateSteps, 
             "badep"], $CellContext`l, $CellContext`r, "permutation"],
           SelectWithContents->True,
           Selectable->False], "]"}], ";", " ", "$Failed"}], ",", "\n", 
        "\t\t", 
        RowBox[{"PermutationMatrix", "[", 
         RowBox[{
          RowBox[{"Range", "[", "dim", "]"}], " ", "/.", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"l", " ", "->", " ", "r"}], ",", " ", 
            RowBox[{"r", " ", "->", " ", "l"}]}], "}"}]}], "]"}]}], "\n", 
       "\t", "]"}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"m", " ", "=", " ", "init"}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"Print", "[", 
      RowBox[{"0", ",", " ", "\"\<\\t\>\"", ",", " ", 
       RowBox[{"MatrixForm", " ", "@", " ", "m"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\t", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
       RowBox[{"i", " ", "<=", " ", 
        RowBox[{"Length", "[", "studentSteps", "]"}]}], ",", " ", 
       RowBox[{"i", "++"}], ",", " ", "\n", "\t\t", 
       RowBox[{
        RowBox[{"m", " ", "=", " ", 
         RowBox[{"Evaluate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"studentSteps", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", " ", "1"}], "]"}], "]"}], "[", 
            RowBox[{"d", ",", " ", 
             RowBox[{"studentSteps", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", " ", 
                RowBox[{"2", ";;"}]}], "]"}], "]"}]}], "]"}], ".", "m"}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
        RowBox[{"Print", "[", 
         RowBox[{"i", ",", " ", "\"\<\\t\>\"", ",", " ", 
          RowBox[{"MatrixForm", " ", "@", " ", "m"}]}], "]"}]}]}], "\n", "\t",
       "]"}], ";", "\n", "\t", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"m", " ", "!=", " ", 
        RowBox[{"RowReduce", "[", "init", "]"}]}], ",", " ", 
       RowBox[{"Message", "[", 
        RowBox[{"GenerateSteps", "::", "notfinished"}], "]"}]}], "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GenerateSteps", "::", "notfinished"}], " ", "=", " ", 
   "\"\<Final result is not in rref yet.\>\""}], ";"}], "\n", 
 RowBox[{
