Cell["Deals with flattened operations for faster typing:", "CodeText",
 CellChangeTimes->{{3.998398953710719*^9, 
  3.9983989666207848`*^9}},ExpressionUUID->"50fcceae-45e0-49ea-bd91-\
0a2ca1495924"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GenerateSteps", "[", 
   RowBox[{"init_List", ",", " ", 
    RowBox[{"studentStepsFlat_List", " ", "/;", " ", 
     RowBox[{
      RowBox[{"Depth", "[", "studentStepsFlat", "]"}], " ", "==", " ", 
      "2"}]}]}], "]"}], " ", ":=", " ", 
  RowBox[{"GenerateSteps", "[", "\n", "\t", 
   RowBox[{"init", ",", "\n", "\t", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"raw", " ", "=", " ", 
        RowBox[{"Flatten", "@", 
         RowBox[{"Position", "[", 
          RowBox[{
           RowBox[{"Head", " ", "/@", " ", "studentStepsFlat"}], ",", " ", 
           "Symbol"}], "]"}]}]}], "}"}], ",", "\n", "\t", 
      RowBox[{
       RowBox[{
        RowBox[{"studentStepsFlat", "[", 
         RowBox[{"[", 
          RowBox[{"Span", "@@", "#"}], "]"}], "]"}], "&"}], " ", "/@", " ", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"raw", "[", 
             RowBox[{"[", 
              RowBox[{";;", 
               RowBox[{"-", "2"}]}], "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"raw", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;"}], "]"}], "]"}], " ", "-", " ", "1"}]}], 
           "}"}], "\[Transpose]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"raw", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], ",", " ", 
           RowBox[{"-", "1"}]}], "}"}]}], "]"}]}]}], "]"}]}], "\n", 
   "]"}]}]], "Code",
 CellChangeTimes->{{3.99839223687848*^9, 3.9983924410818872`*^9}, {
   3.998392493826975*^9, 3.9983925162193127`*^9}, {3.9983925473440323`*^9, 
   3.998392729398098*^9}, {3.9983927731399183`*^9, 3.998392833063019*^9}, {
