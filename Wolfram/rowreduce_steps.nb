Cell[TextData[{
 "Scaling: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"s", ",", " ", "idx", ",", " ", "c"}], "}"}]], "InlineCode",
  ExpressionUUID->"0779514d-2116-429a-8b64-597b53687a99"],
 ": does  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox[
          StyleBox["R", "TI"], "idx", "\[Prime]"], "\[LeftArrow]", 
         StyleBox["c", "TI"], 
         SubscriptBox[
          StyleBox["R", "TI"], "idx"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "R_{\\text{idx}}' \\leftarrow c R_{\\text{idx}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7ab1448b-39f0-43b1-90a9-48c93b78fe44"]
}], "Item",
