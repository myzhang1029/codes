Cell[BoxData[{
 RowBox[{
  RowBox[{"GenerateSteps", "[", 
   RowBox[{"init_List", ",", " ", 
    RowBox[{"studentSteps_List", " ", "/;", " ", 
     RowBox[{
      RowBox[{"Depth", "[", "studentSteps", "]"}], " ", "==", " ", "3"}]}]}], 
   "]"}], " ", ":=", " ", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "e", ",", " ", "s", ",", " ", "p", ",", " ", "m", ",", " ", "i", ",", 
      " ", 
      RowBox[{"d", " ", "=", " ", 
       RowBox[{"Length", "[", "init", "]"}]}]}], "}"}], ",", "\n", "\t", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"dst", "'"}], " ", "=", " ", 
      RowBox[{"dst", " ", "+", " ", 
       RowBox[{"scale", " ", "*", " ", "src"}]}]}], " ", "*)"}], 
    "\[IndentingNewLine]", "\t", 
    RowBox[{
     RowBox[{
      RowBox[{"e", "[", 
       RowBox[{"dim_Integer", ",", " ", 
        RowBox[{"{", 
         RowBox[{"dst_Integer", ",", " ", "scale_", ",", " ", "src_Integer"}],
          "}"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        InterpretationBox[
         DynamicModuleBox[{Typeset`open = False}, 
          TemplateBox[{"Expression", 
            StyleBox[
            "\"Condition\"", "IconizedCustomName", StripOnInput -> False], 
            GridBox[{{
               RowBox[{
                 TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["Not", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Byte count: \"", "IconizedLabel"], 
