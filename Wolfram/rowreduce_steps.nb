Cell["Automatically right join an identity matrix:", "CodeText",
 CellChangeTimes->{{3.998412352352957*^9, 
  3.9984123605657063`*^9}},ExpressionUUID->"0a298136-6dd0-4086-9fd6-\
dd1823bb9770"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"GenerateStepsI", "[", 
   RowBox[{"init_List", ",", " ", "studentSteps_List"}], "]"}], " ", ":=", 
  " ", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dim", " ", "=", " ", 
      RowBox[{"Length", "[", "init", "]"}]}], "}"}], ",", "\n", "\t", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"dim", " ", "!=", " ", 
       RowBox[{"Length", "[", 
        RowBox[{"init", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"Message", "[", 
        RowBox[{"GenerateSteps", "::", "notsquare"}], "]"}], ";", " ", 
       "$Failed"}], ",", "\n", "\t\t", 
      RowBox[{"GenerateSteps", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{"init", ",", " ", 
          RowBox[{"IdentityMatrix", "[", "dim", "]"}], ",", " ", "2"}], "]"}],
         ",", " ", "studentSteps"}], "]"}]}], "\n", "\t", "]"}]}], "\n", 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GenerateSteps", "::", "notsquare"}], " ", "=", " ", 
   "\"\<Given matrix is not square.\>\""}], ";"}]}], "Code",
 CellChangeTimes->{{3.998412362224659*^9, 3.998412470530032*^9}},
