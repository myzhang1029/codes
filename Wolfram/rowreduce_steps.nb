                 TagBox["328", "IconizedItem"]}]}}, 
             GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
             "Column", 
             GridBoxItemSize -> {
              "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
            Dynamic[Typeset`open]},
           "IconizedObject"]],
         Not[
          And[
          1 <= $CellContext`dst <= $CellContext`dim, 
           1 <= $CellContext`src <= $CellContext`dim, $CellContext`src != \
$CellContext`dst]],
         SelectWithContents->True,
         Selectable->False], ",", " ", 
        RowBox[{
         RowBox[{"Message", "[", 
          InterpretationBox[
           DynamicModuleBox[{Typeset`open = False}, 
            TemplateBox[{"Expression", 
              StyleBox[
              "\"Failure\"", "IconizedCustomName", StripOnInput -> False], 
              GridBox[{{
                 RowBox[{
                   TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                   TagBox["Sequence", "IconizedItem"]}]}, {
                 RowBox[{
                   TagBox["\"Length: \"", "IconizedLabel"], 
                   "\[InvisibleSpace]", 
                   TagBox["4", "IconizedItem"]}]}, {
                 RowBox[{
                   TagBox["\"Byte count: \"", "IconizedLabel"], 
                   "\[InvisibleSpace]", 
                   TagBox["200", "IconizedItem"]}]}}, 
               GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
               "Column", 
               GridBoxItemSize -> {
                "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
              Dynamic[Typeset`open]},
             "IconizedObject"]],
           Sequence[
            
            MessageName[$CellContext`GenerateSteps, 
             "badep"], $CellContext`src, $CellContext`dst, "elimination"],
           SelectWithContents->True,
           Selectable->False], "]"}], ";", " ", "$Failed"}], ",", "\n", 
        "\t\t", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "dim", "]"}], " ", "+", " ", 
         RowBox[{"scale", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"UnitVector", "[", 
             RowBox[{"dim", ",", " ", "dst"}], "]"}], ",", " ", 
            RowBox[{"UnitVector", "[", 
             RowBox[{"dim", ",", " ", "src"}], "]"}]}], "]"}]}]}]}], "\n", 
       "\t", "]"}]}], ";", "\[IndentingNewLine]", "\t", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"idx", "'"}], " ", "=", " ", 
       RowBox[{"scale", " ", "*", " ", "idx"}]}], " ", "*)"}], 
     "\[IndentingNewLine]", "\t", 
     RowBox[{
      RowBox[{"s", "[", 
       RowBox[{"dim_Integer", ",", " ", 
        RowBox[{"{", 
         RowBox[{"idx_Integer", ",", " ", "scale_"}], "}"}]}], "]"}], " ", ":=",
       " ", 
      RowBox[{"If", "[", 
       RowBox[{
        InterpretationBox[
         DynamicModuleBox[{Typeset`open = False}, 
          TemplateBox[{"Expression", 
            StyleBox[
            "\"Condition\"", "IconizedCustomName", StripOnInput -> False], 
            GridBox[{{
               RowBox[{
                 TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                 TagBox["Not", "IconizedItem"]}]}, {
               RowBox[{
                 TagBox["\"Byte count: \"", "IconizedLabel"], 
                 "\[InvisibleSpace]", 
                 TagBox["128", "IconizedItem"]}]}}, 
             GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
             "Column", 
             GridBoxItemSize -> {
              "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
            Dynamic[Typeset`open]},
           "IconizedObject"]],
         Not[1 <= $CellContext`idx <= $CellContext`dim],
         SelectWithContents->True,
         Selectable->False], ",", " ", 
        RowBox[{
         RowBox[{"Message", "[", 
          InterpretationBox[
           DynamicModuleBox[{Typeset`open = False}, 
            TemplateBox[{"Expression", 
              StyleBox[
              "\"Failure\"", "IconizedCustomName", StripOnInput -> False], 
              GridBox[{{
                 RowBox[{
                   TagBox["\"Head: \"", "IconizedLabel"], "\[InvisibleSpace]", 
                   TagBox["Sequence", "IconizedItem"]}]}, {
                 RowBox[{
                   TagBox["\"Length: \"", "IconizedLabel"], 
                   "\[InvisibleSpace]", 
                   TagBox["2", "IconizedItem"]}]}, {
                 RowBox[{
                   TagBox["\"Byte count: \"", "IconizedLabel"], 
                   "\[InvisibleSpace]", 
                   TagBox["144", "IconizedItem"]}]}}, 
